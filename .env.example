# Every setting this service reads, and nothing else. ADR 0022.
#
# Copy to `.env` and edit. `.env` is ignored by git; this file is committed and
# must never hold a real value.
#
# `config.py` reads these through Pydantic Settings with `extra="forbid"`, so a
# misspelled variable stops the process at startup rather than silently keeping a
# default. `test_the_example_file_names_every_setting` fails if this file and
# `Settings` ever disagree, because an example that has drifted is worse than no
# example: it tells you the wrong thing with confidence.

# ---------------------------------------------------------------------- required

# A plain libpq connection URL, as psycopg and psql accept it. **Not** SQLAlchemy's
# `postgresql+psycopg://` form — `psycopg.connect` rejects that outright, and
# `migrations/env.py` adds the dialect prefix itself so that one variable can serve
# both readers. ADR 0017.
#
# The value below has no password, which is deliberate: it matches what
# `compose.yaml` runs locally, where PostgreSQL uses trust authentication and there
# is no password to have. **A deployment's URL will contain one**, written between
# the user and the host in the usual way, and that value belongs in the
# deployment's own secret store — never in this file and never in a commit.
#
# Not even as an example. `test_no_secret_is_committed` looks for a URL carrying a
# password, and it does not make an exception for this file: a guard with a
# placeholder allowance is a guard that can be talked into ignoring the real thing.
DATABASE_URL=postgresql://postgres@localhost:5432/ingestion

# ---------------------------------------------------------------------- optional
# Each of these has the default shown. They are listed because a setting nobody
# knows about is a setting nobody can change.

# Anything Python's `logging` accepts: DEBUG, INFO, WARNING, ERROR, CRITICAL.
# One JSON object per line on stdout, whatever the level. ADR 0016.
LOG_LEVEL=INFO

# The largest request body the service will read, in bytes **on the wire**.
# Deliberately larger than the domain's 5 MiB limit on decoded content: base64
# inside JSON expands by a third, so the largest legal document arrives as roughly
# 6.7 MiB. Lowering this below that would refuse documents the domain accepts.
# ADR 0018.
MAX_BODY_BYTES=7340032
